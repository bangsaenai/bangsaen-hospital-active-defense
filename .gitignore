# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C/C++ Build Artifacts & Temporary Directories
build/
temp.*/
*.obj
*.o
*.lib
*.exp

# Ignore generated dynamic headers (Protect raw structures)
core/include/generated_vip_data.h

# Explicitly ALLOW pre-built binaries in releases folder for Arena testing
*.pyd
!releases/*.pyd

# Raw Data Source & Forensic Dump Logs (Zero-Data Leakage)
data_source/
audit_record_dump_*.json

# Environment & Secret Configurations
.env
.venv/
env/
venv/
ENV/

# IDE / Editor Specific Files
.vscode/
.idea/
*.swp
*.swo

# OS Specific Files
.DS_Store
Thumbs.db